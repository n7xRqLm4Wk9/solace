+#ifdef SOLACE_WASM
+bool Network::load_from_memory(const void* data, usize size, EvalFile& evalFile) {
+    if (!data || size == 0)
+        return false;
+
+    // Same trick as load_internal(): a streambuf over memory, so nothing is
+    // copied and no file has to exist.
+    class MemoryBuffer: public std::basic_streambuf<char> {
+       public:
+        MemoryBuffer(char* p, usize n) { setg(p, p, p + n); setp(p, p + n); }
+    };
+
+    MemoryBuffer buffer(const_cast<char*>(reinterpret_cast<const char*>(data)), size);
+    std::istream stream(&buffer);
+
+    auto description = load(stream);
+    if (!description.has_value())
+        return false;
+
+    evalFile.current        = evalFile.defaultName;
+    evalFile.netDescription = description.value();
+    return true;
+}
+#endif
+
+
 void Network::initialize() { initialized = true; }
 
 
