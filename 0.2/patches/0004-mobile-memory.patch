+#ifdef SOLACE_WASM
+bool Engine::load_network_from_memory(const void* data, usize size) {
+    bool loaded = true;
+
+    network.modify_and_replicate([&](NN::Network& network_) {
+        loaded = loaded && network_.load_from_memory(data, size, networkFile);
+    });
+
+    threads.clear();
+    threads.ensure_network_replicated();
+    return loaded;
+}
+#endif
