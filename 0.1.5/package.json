{
  "name": "solace-chess-engine",
  "version": "0.1.5",
  "description": "SOLACE - an independent chess engine written in plain JavaScript (UCI, browser UI, tests and benchmarks)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "solace": "./cli.js"
  },
  "scripts": {
